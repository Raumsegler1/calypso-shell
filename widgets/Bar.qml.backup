import QtQuick
import QtQuick.Layouts
import QtQuick.Effects
import Quickshell
import Quickshell.Widgets
import qs.config
import qs.widgets
import qs.components
import qs.services

Scope {
    Variants {
        model: Quickshell.screens
        PanelWindow {
            id: mainBar
            required property var modelData
            screen: modelData

            property int extraSpace: Theme.screenCorner ? Theme.cornerRadius : 0
            anchors { left: true; top: true; bottom: true }
            implicitWidth: Theme.widgetwidth + Theme.widgetmargin*2 + extraSpace
            margins { top: Theme.barmargin; bottom: Theme.barmargin; left: Theme.barmargin; right: Theme.barmarginr - extraSpace}
            color: '#00ffffff'
            visible: true

            RoundCorner {
                anchors.top: parent.top
                anchors.right: parent.right
                corner: RoundCorner.CornerEnum.TopLeft
                implicitSize: extraSpace
                color: Theme.background
            }

            RoundCorner {
                anchors.bottom: parent.bottom
                anchors.right: parent.right
                corner: RoundCorner.CornerEnum.BottomLeft
                implicitSize: extraSpace
                color: Theme.background
            }

            Rectangle {
                id: barShape 
                anchors { left: parent.left; top: parent.top; bottom: parent.bottom }
                implicitWidth: Theme.widgetwidth + Theme.widgetmargin*2
                color: Theme.background
                radius: Theme.barradius
                visible: true

                Clock {
                    id: clock
                    anchors.centerIn: parent
                    implicitWidth: Theme.widgetwidth
                    implicitHeight: Theme.widgetwidth * 2
                    anchors.margins: Theme.widgetmargin
                }

                // Order is Important (maybe not anymore) It needs to be bottom to top or it will have incorrect anchor behaivor
                MediaWidget {
                    id: media
                    anchors.top: workspaces.bottom
                    anchors.margins: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }

                Workspaces { 
                    id: workspaces
                    anchors.top: user.bottom
                    anchors.margins: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                } // Workspaces with decoraction // Workspaces2 without

                User {
                    id: user
                    bar: barShape
                    anchors.top: parent.top
                    anchors.margins: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }   


                Volume {
                    id: volume
                    anchors.bottom: cpu.top
                    anchors.margins: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }

                CpuWidget {
                    id: cpu
                    anchors.bottom: ram.top
                    anchors.margins: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }

                MemoryWidget {
                    id: ram
                    anchors.bottom: network.top
                    anchors.margins: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }

                NetworkWidget {
                    id: network
                    anchors.bottom: battery.top
                    anchors.margins: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }

                Battery{
                    id: battery
                    anchors.bottom: power.top
                    anchors.bottomMargin: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }

                Power {
                    id: power 
                    bar: barShape
                    anchors.bottom: parent.bottom
                    anchors.bottomMargin: Theme.widgetmargin
                    anchors.horizontalCenter: parent.horizontalCenter
                }
            }
        }
    }
}